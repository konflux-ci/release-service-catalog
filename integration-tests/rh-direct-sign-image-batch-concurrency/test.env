uuid=${uuid:-"$(openssl rand -hex 4)"}
uuid="${uuid:0:8}"

export originating_tool="rh-direct-sign-image-batch-concurrency-test"

# Namespaces
export tenant_namespace=dev-release-team-tenant
#
## Since this is a test that requires internal services,
## this name should not change.
#
export managed_namespace=managed-release-team-tenant

export application_name=batch-concur-app-${uuid}
export component_type=batch-concur
export component_name=${component_type}-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
export component_base_branch=collectors-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/${component_repo_name}

export tenant_sa_name=${component_type}-sa-${uuid}
export release_plan_name=${component_type}-rp-${uuid}

export managed_sa_name=${component_type}-sa-${uuid}
export release_plan_admission_name=${component_type}-rpa-${uuid}

# Timeout for the managed (rh-advisories) pipeline/tasks timeouts in rpa.yaml.
export BATCH_TEST_TIMEOUT="${BATCH_TEST_TIMEOUT:-2h30m0s}"

# Name of this test's Snapshot, applied directly (not managed by kustomize).
export batch_test_snapshot_name="rh-direct-sign-image-batch-${uuid}"

# Base name used for the generated tags on the single test component. The
# actual number of tags is computed at runtime (see compute_batch_tag_count.py)
# so that rh-direct-sign-image's batch_signing_items() reliably splits them
# into exactly TARGET_BATCH_COUNT signing batches.
#
# Default is comfortably above rh-direct-sign-image's concurrentLimit (24):
# submit_batches() only starts a batch beyond the first 24 once an earlier
# one frees a worker slot, so a count this far past 24 gives many such
# "late dispatch" events a chance to land while an earlier sibling batch
# (same pod, same pipelinerun-uid) is still running — the condition under
# which cleanup's creator-pod scoping actually has something to preserve.
# This raises the odds but does not guarantee it on any single run (see
# README.md).
export BATCH_TAG_PREFIX="${component_name}"
export TARGET_BATCH_COUNT="${TARGET_BATCH_COUNT:-40}"

#!/usr/bin/env bash
# base-test.env - Common environment variables for all integration tests
#
# This file is sourced by run-test.sh before the test-specific test.env.
# Test suites should define only the unique variables in their test.env,
# letting this file provide the common configuration.
#
# Required overrides in test-specific test.env:
#   - originating_tool: Unique identifier for the test (e.g., "push-to-external-registry-e2e-test")
#   - component_type: Short name for the component type (e.g., "push-to-external-registry")
#   - component_base_branch: The base branch in e2e-base repo (e.g., "push-to-external-registry-base")
#
# Optional overrides:
#   - application_name_prefix: Override the application name prefix (defaults to component_type)
#   - Any other variable that needs customization

# --- UUID Generation ---
# Generate a unique identifier for this test run if not already set
uuid=${uuid:-"$(openssl rand -hex 4)"}
# Ensure uuid is 8 characters long
uuid="${uuid:0:8}"
export uuid

# --- Namespace Configuration ---
# These are the standard namespaces used by all integration tests
export tenant_namespace=dev-release-team-tenant
# Since tests require internal services, this name should not change
export managed_namespace=managed-release-team-tenant

# --- GitHub Configuration ---
export component_github_org=hacbs-release-tests
export component_base_repo_name=${component_github_org}/e2e-base

# --- Component Configuration ---
# These use the component_type defined by the test suite
# The component_type MUST be set before this file is sourced (set in test.env)
_set_component_defaults() {
    # Application name (can be overridden by setting application_name_prefix in test.env)
    local app_prefix="${application_name_prefix:-${component_type}}"
    export application_name=${application_name:-"${app_prefix}-app-${uuid}"}

    # Component naming
    export component_name=${component_name:-"${component_type}-${uuid}"}
    export component_branch=${component_branch:-"${component_name}"}

    # Do not change this - it is a known branch created by Konflux
    export appstudio_component_branch="appstudio-${component_name}"

    # Repository configuration
    export component_repo_name=${component_repo_name:-"${component_github_org}/${component_name}"}
    export component_git_url=${component_git_url:-"https://github.com/${component_repo_name}"}

    # Service account and release plan naming
    export tenant_sa_name=${tenant_sa_name:-"${component_type}-sa-${uuid}"}
    export release_plan_name=${release_plan_name:-"${component_type}-rp-${uuid}"}
    export managed_sa_name=${managed_sa_name:-"${component_type}-sa-${uuid}"}
    export release_plan_admission_name=${release_plan_admission_name:-"${component_type}-rpa-${uuid}"}
}

# This function is called after the test-specific test.env is sourced
# to finalize the environment variable configuration
finalize_test_env() {
    _set_component_defaults
}


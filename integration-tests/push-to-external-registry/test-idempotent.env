# Source the base test.env for shared configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/test.env"

# Override only the values specific to idempotent testing
export originating_tool="push-to-external-registry-idempotent-e2e-test"
export application_name=push-external-idempotent-app-${uuid}


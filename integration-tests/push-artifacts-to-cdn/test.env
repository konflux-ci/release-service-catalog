uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
export uuid="${uuid:0:8}"

export originating_tool="push-artifacts-to-cdn-e2e-test"

# Namespaces
export tenant_namespace=dev-release-team-tenant
export managed_namespace=managed-release-team-tenant

export application_name=push-artifacts-cdn-app-${uuid}
export component_type=push-artifacts-cdn
export component_name=${component_type}-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
# Base branch in e2e-base for component 1 (pushes to Pulp + CGW).
# This branch must contain a Dockerfile and 3 binary files:
#   /releases/e2e-cdn-comp1-windows-amd64.tar.gz (tar.gz wrapping a real PE executable for Windows signing)
#   /releases/e2e-cdn-comp1-linux-amd64.tar.gz   (Linux binary archive)
#   /releases/e2e-cdn-comp1-darwin-amd64.tar.gz  (tar.gz wrapping a real Mach-O binary for Mac signing)
export component_base_branch=push-artifacts-to-cdn-comp1-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/${component_repo_name}

# Component 2 uses the same dynamic repo but a different base branch.
# Base branch in e2e-base for component 2 (pushes to CGW only, no Pulp).
# This branch must contain a Dockerfile and 3 binary files:
#   /releases/e2e-cdn-comp2-windows-amd64.tar.gz (tar.gz wrapping a real PE executable for Windows signing)
#   /releases/e2e-cdn-comp2-linux-amd64.tar.gz   (Linux binary archive)
#   /releases/e2e-cdn-comp2-darwin-amd64.tar.gz  (tar.gz wrapping a real Mach-O binary for Mac signing)
export component2_name=${component_type}-comp2-${uuid}
export component2_branch=${component2_name}
export component2_base_branch=push-artifacts-to-cdn-comp2-base
export component2_base_repo_name=${component_base_repo_name}
export component2_repo_name=${component_repo_name}
export component2_git_url=https://github.com/${component2_repo_name}
export component2_github_org=${component_github_org}
export component2_type=${component_type}

# Component 3: disk image (contentType: disk-image), pushed to both Pulp and CGW.
# Base branch in e2e-base for component 3 (pushes to Pulp + CGW, same as component 1).
# This branch must contain a Dockerfile and one disk image file:
#   /releases/e2e-cdn-comp3-rhel10-x86_64.qcow2 (small QCOW2, os: linux only)
export component3_name=${component_type}-comp3-${uuid}
export component3_branch=${component3_name}
export component3_base_branch=push-artifacts-to-cdn-comp3-base
export component3_base_repo_name=${component_base_repo_name}
export component3_repo_name=${component_repo_name}
export component3_git_url=https://github.com/${component3_repo_name}
export component3_github_org=${component_github_org}
export component3_type=${component_type}

export tenant_collector_sa_name=push-artifacts-cdn-rp-${uuid}
export release_plan_name=push-artifacts-cdn-rp-${uuid}

export managed_sa_name=push-artifacts-cdn-sa-${uuid}
export release_plan_admission_name=push-artifacts-cdn-rpa-${uuid}

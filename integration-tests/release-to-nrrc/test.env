uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
uuid="${uuid:0:8}"

export originating_tool="release-to-nrrc-e2e-test"

# Skip component build workflow - use pre-built snapshot
export skip_build=true

# Namespaces
export tenant_namespace=dev-release-team-tenant
export managed_namespace=managed-release-team-tenant

export application_name=nrrc-app-${uuid}
export component_type=release-to-nrrc
export component_name=${component_type}-${uuid}
#export component_branch=${component_name}
export component_branch=main
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

#TBD change these configuration
export component_github_org=hacbs-release-tests
export component_base_branch=push-to-external-registry-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://gitlab.cee.redhat.com/gli/quarkus-maven-ta

export snapshot_name=${component_type}-snapshot-${uuid}
export container_image="quay.io/hacbs-release-tests/nrrc@sha256:0154b5c623702ac68a2deeb9d5603be1c2c6e1bdb5d62b3d6dae57b52cd00b83"

export tenant_sa_name=release-to-nrrc-sa-${uuid}
export release_plan_name=release-to-nrrc-rp-${uuid}

export managed_sa_name=release-to-nrrc-sa-${uuid}
export release_plan_admission_name=release-to-nrrc-rpa-${uuid}

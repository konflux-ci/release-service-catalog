uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
uuid="${uuid:0:8}"

export originating_tool="rh-push-helm-chart-to-registry-redhat-io-e2e-test"

# Namespaces
export tenant_namespace=dev-release-team-tenant
export managed_namespace=managed-release-team-tenant

export application_name=rh-redhat-app-${uuid}
export component_type=rh-push-helm-chart-to-registry-redhat-io

# Image basename must stay fixed — validate-helm-chart-snapshot checks
# OCI title == Pyxis delivery repo basename, and publish-pyxis-repository
# requires the repo to already exist. The K8s Component name uses UUID
# for parallel-run isolation; containerImage keeps the basename fixed.
export component_image_basename=caching-helm-test-rhel9
export component_name=${component_image_basename}-${uuid}
export container_image=quay.io/redhat-user-workloads-stage/${tenant_namespace}/${application_name}/${component_image_basename}
export image_repository_name=imagerepository-for-${application_name}-${component_image_basename}

# GitHub repo and branch still use UUID for test-run isolation
export component_github_org=hacbs-release-tests
export component_base_repo_name=${component_github_org}/e2e-base
export component_base_branch=rh-push-helm-chart-to-registry-redhat-io-base
export component_repo_name=${component_github_org}/${component_type}-${uuid}
export component_branch=${component_type}-${uuid}
export component_git_url=https://github.com/$component_repo_name

export appstudio_component_branch="appstudio-${component_name}"

export release_plan_name=rh-push-helm-chart-to-registry-redhat-io-rp-${uuid}

export managed_sa_name=rh-push-helm-chart-to-registry-redhat-io-sa-${uuid}
export release_plan_admission_name=rh-push-helm-chart-to-registry-redhat-io-rpa-${uuid}

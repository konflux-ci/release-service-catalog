uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
uuid="${uuid:0:8}"

export originating_tool="fbc-release-e2e-test"

# Namespaces
export tenant_namespace=dev-release-team-tenant
#
## Since this is a test that requires internal services,
## this name should not change.
#
export managed_namespace=managed-release-team-tenant

export application_name=fbc-app-${uuid}
export component_type=fbc-release
export component_name=${component_type}-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
export component_base_branch=fbc-release-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/$component_repo_name

# Component 2 configuration (for multi-component tests)
# Uses a different base branch to avoid duplicate package conflicts
export component2_name=${component_type}-comp2-${uuid}
export component2_type=${component_type}
export component2_github_org=${component_github_org}
export component2_branch=${component2_name}
export component2_base_branch=fbc-release-multi-component-base
export component2_repo_name=${component_repo_name}
export component2_base_repo_name=${component_github_org}/e2e-base
export component2_git_url=https://github.com/${component2_repo_name}

# Opt-in applications
export optin_application_name=optin-${application_name}
export multi_optin_application_name=multi-optin-${application_name}

#FBC opt-in component configuration
export optin_component_name=${component_type}-optin-${uuid}
export optin_component_type=${component_type}
export optin_component_github_org=${component_github_org}
export optin_component_branch=${optin_component_name}
export optin_component_repo_name=${component_github_org}/${optin_component_name}
export optin_component_base_branch=main
export optin_component_base_repo_name=${component_github_org}/e2e-operator-fbc
export optin_component_git_url=https://github.com/${optin_component_repo_name}

# FBC multi-optin component configuration
export optin_component_1_name=${component_type}-multi-optin-comp-1-${uuid}
export optin_component_1_type=${component_type}
export optin_component_1_github_org=${component_github_org}
export optin_component_1_branch=${optin_component_1_name}
export optin_component_1_repo_name=${component_github_org}/${optin_component_1_name}
export optin_component_1_base_branch=main
export optin_component_1_base_repo_name=${component_github_org}/e2e-operator-fbc
export optin_component_1_git_url=https://github.com/${optin_component_1_repo_name}

export optin_component_2_name=${component_type}-multi-optin-comp-2-${uuid}
export optin_component_2_type=${component_type}
export optin_component_2_github_org=${component_github_org}
export optin_component_2_branch=${optin_component_2_name}
export optin_component_2_repo_name=${component_github_org}/${optin_component_2_name}
export optin_component_2_base_branch=main
export optin_component_2_base_repo_name=${component_github_org}/e2e-operator-fbc
export optin_component_2_git_url=https://github.com/${optin_component_2_repo_name}
# == end components ==

export tenant_sa_name=fbc-release-sa-${uuid}
export release_plan_happy_name=fbc-release-happy-rp-${uuid}
export release_plan_hotfix_name=fbc-release-hotfix-rp-${uuid}
export release_plan_prega_name=fbc-release-prega-rp-${uuid}
export release_plan_staged_name=fbc-release-staged-rp-${uuid}
export release_plan_optin_name=fbc-release-optin-rp-${uuid}
export release_plan_multi_optin_name=fbc-release-multi-optin-rp-${uuid}

export managed_sa_name=fbc-release-sa-${uuid}
export release_plan_admission_happy_name=fbc-release-happy-rpa-${uuid}
export release_plan_admission_hotfix_name=fbc-release-hotfix-rpa-${uuid}
export release_plan_admission_prega_name=fbc-release-prega-rpa-${uuid}
export release_plan_admission_staged_name=fbc-release-staged-rpa-${uuid}
export release_plan_admission_optin_name=fbc-release-optin-rpa-${uuid}
export release_plan_admission_multi_optin_name=fbc-release-multi-optin-rpa-${uuid}

# All ReleasePlans set to manual triggering
export release_plan_happy_auto_release='"false"'
export release_plan_hotfix_auto_release='"false"'
export release_plan_prega_auto_release='"false"'
export release_plan_staged_auto_release='"false"'
export release_plan_optin_auto_release='"false"'
export release_plan_multi_optin_auto_release='"false"'

export PTSV_COMPONENTS="component component2 optin_component optin_component_1 optin_component_2"

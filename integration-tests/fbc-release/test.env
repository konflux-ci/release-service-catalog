uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
uuid="${uuid:0:8}"

export originating_tool="fbc-release-e2e-test"

# Namespaces
export tenant_namespace=dev-release-team-tenant
#
## Since this is a test that requires internal services,
## this name should not change.
#
export managed_namespace=managed-release-team-tenant

# NOTE: the component/application layout below is intentionally split per
# scenario (single-happy and multi-happy run in isolated applications with their
# own components and OCP versions). See README.md sections "Why the components
# are separated" and "Where the directory structure comes from" for the rationale
# (IIB build reuse, overwrite_from_index, per-OCP split, and base-repo layouts).
export application_name=fbc-app-${uuid}
export component_type=fbc-release
export component_name=${component_type}-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
export component_base_branch=fbc-release-multi-base
export component_repo_name=${component_github_org}/${component_name}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/$component_repo_name

# Component 2 configuration (for multi-component tests)
# Same base branch as component, different operator (example-operator2 via its
# own context dir). component and component2 build at different OCP versions, so
# the multi snapshot spans two OCP groups (per-OCP split, not same-OCP batching)
export component2_name=${component_type}-comp2-${uuid}
export component2_type=${component_type}
export component2_github_org=${component_github_org}
export component2_branch=${component2_name}
export component2_base_branch=fbc-release-multi-base
export component2_repo_name=${component_repo_name}
export component2_base_repo_name=${component_github_org}/e2e-base
export component2_git_url=https://github.com/${component2_repo_name}

# Happy (GA) single-component configuration (isolated, see happy_application_name)
export happy_component_name=${component_type}-happy-${uuid}
export happy_component_type=${component_type}
export happy_component_github_org=${component_github_org}
export happy_component_branch=${happy_component_name}
export happy_component_base_branch=fbc-release-multi-base
export happy_component_repo_name=${component_github_org}/${happy_component_name}
export happy_component_base_repo_name=${component_github_org}/e2e-base
export happy_component_git_url=https://github.com/${happy_component_repo_name}

# Multi-happy (GA, overwrite) configuration: isolated 2-component pair so its
# overwrite_from_index build never shares a snapshot/reuse-key with multi-staged.
# Two components (example-operator via component/, example-operator2 via
# component2/) at DIFFERENT OCP versions, so the snapshot spans two OCP groups
# (per-OCP split, not same-OCP batching).
export multi_happy_component_1_name=${component_type}-multi-happy-1-${uuid}
export multi_happy_component_1_type=${component_type}
export multi_happy_component_1_github_org=${component_github_org}
export multi_happy_component_1_branch=${multi_happy_component_1_name}
export multi_happy_component_1_base_branch=fbc-release-multi-base
export multi_happy_component_1_repo_name=${component_github_org}/${multi_happy_component_1_name}
export multi_happy_component_1_base_repo_name=${component_github_org}/e2e-base
export multi_happy_component_1_git_url=https://github.com/${multi_happy_component_1_repo_name}

export multi_happy_component_2_name=${component_type}-multi-happy-2-${uuid}
export multi_happy_component_2_type=${component_type}
export multi_happy_component_2_github_org=${component_github_org}
export multi_happy_component_2_branch=${multi_happy_component_2_name}
export multi_happy_component_2_base_branch=fbc-release-multi-base
export multi_happy_component_2_repo_name=${multi_happy_component_1_repo_name}
export multi_happy_component_2_base_repo_name=${component_github_org}/e2e-base
export multi_happy_component_2_git_url=https://github.com/${multi_happy_component_2_repo_name}

# Opt-in applications
export optin_application_name=optin-${application_name}
export multi_optin_application_name=multi-optin-${application_name}

# Happy (GA) release uses overwrite_from_index, so it must not share a snapshot
# (and therefore an IIB reuse key) with the non-overwrite single scenarios.
export happy_application_name=happy-${application_name}
# multi-happy (GA, overwrite) isolated application
export multi_happy_application_name=multi-happy-${application_name}

#FBC opt-in component configuration
export optin_component_name=${component_type}-optin-${uuid}
export optin_component_type=${component_type}
export optin_component_github_org=${component_github_org}
export optin_component_branch=${optin_component_name}
export optin_component_repo_name=${component_github_org}/${optin_component_name}
export optin_component_base_branch=main
export optin_component_base_repo_name=${component_github_org}/e2e-operator-fbc
export optin_component_git_url=https://github.com/${optin_component_repo_name}

# FBC multi-optin component configuration
export optin_component_1_name=${component_type}-multi-optin-comp-1-${uuid}
export optin_component_1_type=${component_type}
export optin_component_1_github_org=${component_github_org}
export optin_component_1_branch=${optin_component_1_name}
export optin_component_1_repo_name=${component_github_org}/${optin_component_1_name}
export optin_component_1_base_branch=main
export optin_component_1_base_repo_name=${component_github_org}/e2e-operator-fbc
export optin_component_1_git_url=https://github.com/${optin_component_1_repo_name}

export optin_component_2_name=${component_type}-multi-optin-comp-2-${uuid}
export optin_component_2_type=${component_type}
export optin_component_2_github_org=${component_github_org}
export optin_component_2_branch=${optin_component_2_name}
export optin_component_2_repo_name=${component_github_org}/${optin_component_2_name}
export optin_component_2_base_branch=main
export optin_component_2_base_repo_name=${component_github_org}/e2e-operator-fbc
export optin_component_2_git_url=https://github.com/${optin_component_2_repo_name}
# == end components ==

export tenant_sa_name=fbc-release-sa-${uuid}
export release_plan_happy_name=fbc-release-happy-rp-${uuid}
export release_plan_hotfix_name=fbc-release-hotfix-rp-${uuid}
export release_plan_prega_name=fbc-release-prega-rp-${uuid}
export release_plan_staged_name=fbc-release-staged-rp-${uuid}
export release_plan_optin_name=fbc-release-optin-rp-${uuid}
export release_plan_multi_optin_name=fbc-release-multi-optin-rp-${uuid}
export release_plan_multi_happy_name=fbc-release-multi-happy-rp-${uuid}

export managed_sa_name=fbc-release-sa-${uuid}
export release_plan_admission_happy_name=fbc-release-happy-rpa-${uuid}
export release_plan_admission_hotfix_name=fbc-release-hotfix-rpa-${uuid}
export release_plan_admission_prega_name=fbc-release-prega-rpa-${uuid}
export release_plan_admission_staged_name=fbc-release-staged-rpa-${uuid}
export release_plan_admission_optin_name=fbc-release-optin-rpa-${uuid}
export release_plan_admission_multi_optin_name=fbc-release-multi-optin-rpa-${uuid}
export release_plan_admission_multi_happy_name=fbc-release-multi-happy-rpa-${uuid}

# All ReleasePlans set to manual triggering
export release_plan_happy_auto_release='"false"'
export release_plan_hotfix_auto_release='"false"'
export release_plan_prega_auto_release='"false"'
export release_plan_staged_auto_release='"false"'
export release_plan_optin_auto_release='"false"'
export release_plan_multi_optin_auto_release='"false"'
export release_plan_multi_happy_auto_release='"false"'

# Scenarios to run. When set, this overrides change-detection and enables exactly
# the listed scenarios (space- or comma-separated); only their components build.
# Leave empty/unset to fall back to change-detection in configure_test_matrix().
# Valid keys: single-happy single-staged single-prega single-hotfix single-optin
#             multi-happy multi-staged multi-optin
export PTSV_FBC_SCENARIOS="single-happy single-staged single-prega"

# Full set of components. This is only the default: at source time test.sh's
# select_components_for_matrix() narrows PTSV_COMPONENTS to just the components
# used by the enabled scenarios (SCENARIO_COMPONENTS map), so disabled scenarios
# don't build their components. Keep this list complete so every component is
# still cleaned up (the pipeline cleanup step sources test.env, not test.sh).
export PTSV_COMPONENTS="component component2 happy_component multi_happy_component_1 multi_happy_component_2 optin_component optin_component_1 optin_component_2"

# available OCP Versions for FBC tests
export OCP_VERSIONS=("4.15" "4.16" "4.17" "4.18" "4.19" "4.20")

# --- select/export the openshift versions to be used in tests
readarray -t OCP_VER < <(shuf -i "0-$((${#OCP_VERSIONS[@]} - 1))" -n 6)

# Each multi-component pair spans TWO different OCP versions, so the snapshot
# exercises add-fbc-contribution's per-OCP splitting (one IIB request per OCP
# group) instead of same-OCP batching. Within-pair versions are distinct.
#
# happy reuses OCP_VER[0] (= component's): the 6-version pool can't give 7
# globally-distinct values. Cross-scenario *build* reuse is still prevented
# (distinct components = distinct fragments = distinct reuse key), BUT happy then
# shares a from_index (iib-preview-rhtap:<OCP>) with the non-overwrite single
# scenarios, so its overwrite can touch a from_index they read. Full per-overwrite
# from_index isolation needs the per-scenario split (each scenario its own run);
# see README "Why the components are separated". Same caveat applies to
# single-optin vs multi-optin-1 (both use optin_component_ocp_ver_1).
#
# bare value: components use the "v${...}" prefix (fbc-release-multi-base keeps
# catalog.Dockerfile under v-prefixed OCP dirs), so the "v" keeps it a string.
export random_component_ocp_ver_1="${OCP_VERSIONS[${OCP_VER[0]}]}"
export random_component_ocp_ver_2="${OCP_VERSIONS[${OCP_VER[1]}]}"
export random_multi_happy_component_ocp_ver_1="${OCP_VERSIONS[${OCP_VER[2]}]}"
export random_multi_happy_component_ocp_ver_2="${OCP_VERSIONS[${OCP_VER[3]}]}"
export random_optin_component_ocp_ver_1="${OCP_VERSIONS[${OCP_VER[4]}]}"
export random_optin_component_ocp_ver_2="${OCP_VERSIONS[${OCP_VER[5]}]}"
export random_happy_component_ocp_ver="${OCP_VERSIONS[${OCP_VER[0]}]}"

#!/usr/bin/env bash
# Tekton test mock for oras pull (called by oras_utils.oras_pull).
set -eu

echo "Mock oras called with: $*" >&2

if [[ "${1}" == "pull" ]]; then
  python3 - <<'PY'
import json
import zipfile
from pathlib import Path

sbom = {
    "spdxVersion": "SPDX-2.3",
    "packages": [
        {
            "name": "test-package",
            "externalRefs": [
                {
                    "referenceCategory": "PACKAGE-MANAGER",
                    "referenceType": "purl",
                    "referenceLocator": "pkg:pypi/test_package@1.0.0",
                }
            ],
        }
    ],
}
with zipfile.ZipFile("test_package-1.0.0-py3-none-any.whl", "w") as archive:
    archive.writestr(
        "test_package-1.0.0.dist-info/sboms/redhat.spdx.json",
        json.dumps(sbom),
    )
Path("test_package-1.0.0.tar.gz").write_text("mock sdist content", encoding="utf-8")
print(f"Created mock files in {Path.cwd()}")
PY
  exit 0
fi

exit 0

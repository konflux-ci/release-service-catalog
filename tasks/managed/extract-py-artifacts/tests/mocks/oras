#!/usr/bin/env bash
# Tekton test mock for oras pull (called by extract_py_artifacts pull_oci_artifacts).
set -eu

echo "Mock oras called with: $*" >&2

if [[ "${1}" != "pull" ]]; then
  exit 0
fi

output_dir="."
skip_next=""
for arg in "$@"; do
  if [[ -n "${skip_next}" ]]; then
    if [[ "${skip_next}" == "output" ]]; then
      output_dir="${arg}"
    fi
    skip_next=""
    continue
  fi
  case "${arg}" in
    -o|--output) skip_next="output" ;;
    --registry-config) skip_next="config" ;;
  esac
done

mkdir -p "${output_dir}"

python3 - "${output_dir}" <<'PY'
import json
import sys
import zipfile
from pathlib import Path

dest = Path(sys.argv[1])
sbom = {
    "spdxVersion": "SPDX-2.3",
    "packages": [
        {
            "name": "test-package",
            "externalRefs": [
                {
                    "referenceCategory": "PACKAGE-MANAGER",
                    "referenceType": "purl",
                    "referenceLocator": "pkg:pypi/test_package@1.0.0",
                }
            ],
        }
    ],
}
with zipfile.ZipFile(dest / "test_package-1.0.0-py3-none-any.whl", "w") as archive:
    archive.writestr(
        "test_package-1.0.0.dist-info/sboms/redhat.spdx.json",
        json.dumps(sbom),
    )
(dest / "test_package-1.0.0.tar.gz").write_text("mock sdist content", encoding="utf-8")
print(f"Created mock files in {dest}")
PY

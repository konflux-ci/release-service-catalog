#!/usr/bin/env bash
# Mock skopeo executable for Tekton task tests.
# Returns a single-manifest JSON. Strips --retry-times N from logged args
# so assertions match the Python skopeo helper, which always adds that flag.
set -euo pipefail

NORMALIZED_ARGS=()
SKIP_NEXT=0
for ARG in "$@"; do
    if [ "${SKIP_NEXT}" -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    if [ "${ARG}" = "--retry-times" ]; then
        SKIP_NEXT=1
        continue
    fi
    NORMALIZED_ARGS+=("${ARG}")
done

echo "${NORMALIZED_ARGS[*]}" >> "${PARAMS_DATA_DIR}/mock_skopeo_calls"

if [ "${1}" = "inspect" ]; then
    echo '{"schemaVersion": 2, "mediaType": "application/vnd.docker.distribution.manifest.v2+json"}'
fi

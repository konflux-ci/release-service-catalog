#!/usr/bin/env bash
# Mock git for push-oot-kmods-to-git Tekton tests. Avoids a real clone/push
# and checks on push that the script actually staged the right artifacts.
set -euo pipefail

echo "mock git: $*" >&2

EXPECTED_FILES=(
  "mocked-vendor/1.0.0/6.5.0/x86_64/mod1.ko"
  "mocked-vendor/1.0.0/6.5.0/x86_64/driver/subdir/nested.ko"
  "mocked-vendor/1.0.0/6.5.0/x86_64/envfile"
  "mocked-vendor/1.0.0/6.5.0/x86_64/signed_kmods_checksums_x86_64.txt"
  "mocked-vendor/1.0.0/6.5.0/aarch64/mod1.ko"
  "mocked-vendor/1.0.0/6.5.0/aarch64/driver/subdir/nested.ko"
  "mocked-vendor/1.0.0/6.5.0/aarch64/envfile"
  "mocked-vendor/1.0.0/6.5.0/aarch64/signed_kmods_checksums_aarch64.txt"
  "mocked-vendor/1.0.0/6.5.0/multi-arch-summary/signing_summary.txt"
  "mocked-vendor/1.0.0/6.5.0/multi-arch-summary/extraction_summary.txt"
)

case "${1:-}" in
  clone)
    dest="${*: -1}"
    mkdir -p "$dest"
    ;;
  sparse-checkout|checkout|config|add|commit)
    ;;
  status)
    # Report whatever the task has actually written into the clone so far,
    # as untracked artifacts, so changed_paths_from_status() sees the artifacts.
    find . -type f | sed 's|^\./|?? |'
    ;;
  push)
    missing=()
    for path in "${EXPECTED_FILES[@]}"; do
      [ -f "$path" ] || missing+=("$path")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
      echo "mock git push: missing expected artifacts: ${missing[*]}" >&2
      exit 1
    fi
    if find . -type f | grep -E '6\.5\.0\.(x86_64|aarch64)' >/dev/null; then
      echo "mock git push: uncleaned kernel version found in staged paths" >&2
      exit 1
    fi
    echo "mock git push: all expected artifacts present, kernel version clean" >&2
    ;;
  *)
    echo "mock git: unexpected command: $*" >&2
    exit 1
    ;;
esac

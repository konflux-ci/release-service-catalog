  touch hello-2.12.1-6.fc44.ppc64le.rpm
  touch hello-2.12.1-6.fc44.s390x.rpm
  touch hello-2.12.1-6.fc44.src.rpm
  touch hello-2.12.1-6.fc44.x86_64.rpm
  touch hello-docs-2.12.1-6.fc44.noarch.rpm
  touch hello-debuginfo-2.12.1-6.fc44.aarch64.rpm
  touch hello-debuginfo-2.12.1-6.fc44.ppc64le.rpm
  touch hello-debuginfo-2.12.1-6.fc44.s390x.rpm
  touch hello-debuginfo-2.12.1-6.fc44.x86_64.rpm
  touch hello-debugsource-2.12.1-6.fc44.aarch64.rpm
  touch hello-debugsource-2.12.1-6.fc44.ppc64le.rpm
  touch hello-debugsource-2.12.1-6.fc44.s390x.rpm
  touch hello-debugsource-2.12.1-6.fc44.x86_64.rpm
  mkdir -p logs
  touch logs/hello-2.12.1-6.fc44.aarch64.rpm.log
  touch logs/hello-2.12.1-6.fc44.ppc64le.rpm.log
  touch logs/hello-2.12.1-6.fc44.s390x.rpm.log
  touch logs/hello-2.12.1-6.fc44.src.rpm.log
  touch logs/hello-2.12.1-6.fc44.x86_64.rpm.log

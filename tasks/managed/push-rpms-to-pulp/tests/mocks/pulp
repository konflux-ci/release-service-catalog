#!/usr/bin/env bash
# Mock pulp CLI: rpm content upload. Domain/repo preflight uses the REST mock.
mkdir -p "${DATA_DIR}"
echo "$*" >> "${DATA_DIR}/mock_pulp.txt"
if [[ "$*" == *"rpm content upload"* ]]; then
  echo '{"pulp_href": "/api/pulp/mock/api/v3/content/rpm/packages/mock-uuid/"}'
else
  echo "Error: Unexpected pulp call: $*" >&2
  exit 1
fi

#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${DATA_DIR:-/var/workdir/release}"
echo "koji $*" >> "${DATA_DIR}/koji_calls.txt"

# Handle different koji commands
case "$*" in
    *getBuildTarget*-sidetag*)
        echo '{"dest_tag_name": "mock-target-sidetag"}'
        ;;
    *getBuildTarget*)
        echo '{"dest_tag_name": "mock-target-candidate"}'
        ;;
    *getTag*-sidetag*)
        echo '{"extra": {"sidetag": true}}'
        ;;
    *getTag*)
        echo '{"extra": {"sidetag": false}}'
        ;;
    *CGInitBuild*\"test-foo\"*)
        echo '{"build_id": 111, "token": "mock-token"}'
        ;;
    *CGInitBuild*\"test-bar\"*)
        echo '{"build_id": 222, "token": "mock-token"}'
        ;;
    *getBuild*test-baz*)
        # Simulate that test-baz was already imported by a previous, partially-failed run
        echo '{"id": 999}'
        ;;
    *getBuild\ *)
        echo 'null'
        ;;
    *hello*)
        echo "hello, test@test.com!"
        ;;
    *)
        # Default: succeed silently
        ;;
esac

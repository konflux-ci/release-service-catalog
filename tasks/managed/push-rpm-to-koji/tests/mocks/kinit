#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${DATA_DIR:-/var/workdir/release}"
echo "kinit $*" >> "${DATA_DIR}/kinit_calls.txt"

# Count how many times kinit has been called
call_count=$(wc -l < "${DATA_DIR}/kinit_calls.txt")

# Simulate kinit failures on first two calls to test retry logic
if [[ "$call_count" -lt 3 ]]; then
    echo "kinit: cannot contact any KDC for realm 'TEST.COM'" >&2
    exit 1
fi

# Succeed on third call
exit 0

#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${DATA_DIR:-/var/workdir/release}"
echo "oras $*" >> "${DATA_DIR}/oras_calls.txt"

if [[ "$1" == "manifest" && "$2" == "fetch" ]]; then
    # Extract image name from args
    image="$3"
    if [[ "$image" == *test-bar* ]]; then
        echo '{"annotations": {"koji.build-target": "mock-target-sidetag"}}'
    else
        echo '{"annotations": {"koji.build-target": "mock-target-candidate"}}'
    fi
elif [[ "$1" == "pull" ]]; then
    # Extract build name from the image reference
    # Images are like quay.io/test/test-foo@sha256:111
    image="${*: -1}"
    build_name=$(echo "$image" | sed -e 's_.*\/__' -e 's_@.*__')

    # Create mock cg_import.json in current directory
    cat > "cg_import.json" <<EOF
{
    "metadata_version": 0,
    "build": {
        "name": "${build_name}",
        "version": "16.1",
        "release": "10.el10_0",
        "epoch": null
    }
}
EOF
    # Create mock source RPM
    touch "${build_name}-16.1-10.el10_0.src.rpm"
fi

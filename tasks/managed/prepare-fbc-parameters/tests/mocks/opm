#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" != "render" ]]; then
  echo "mock opm: unsupported command: $1" >&2
  exit 1
fi

image="$2"
case "${image}" in
  *sha256:f6e744662e342c1321deddb92469b55197002717a15f8c0b1bb2d9440aac2297*)
    cat << 'EOF'
{"schema":"olm.package","name":"example-operator","defaultChannel":"stable"}
{"schema":"olm.bundle","name":"example-operator.v0.1.0","package":"example-operator","image":"quay.io/example/operator-bundle@sha256:aaaa"}
EOF
    ;;
  *sha256:42183bc9716448d0c25dbe35bb1c61661449270c89576bed8b9d46ec8df08a4a*)
    cat << 'EOF'
{"schema":"olm.package","name":"operator-foundry-e2e-example-operator","defaultChannel":"stable"}
{"schema":"olm.bundle","name":"operator-foundry-e2e-example-operator.v0.1.0","package":"operator-foundry-e2e-example-operator","image":"quay.io/example/e2e-bundle@sha256:bbbb"}
EOF
    ;;
  *)
    echo "mock opm: unknown image: ${image}" >&2
    exit 1
    ;;
esac

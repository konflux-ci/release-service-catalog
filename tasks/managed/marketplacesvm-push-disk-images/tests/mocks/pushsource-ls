#!/usr/bin/env bash
set -eo pipefail

# This mock dir is prepended to PATH, so find the real pushsource-ls binary
# further down PATH to actually validate the staged directory.
real_pushsource_ls=$(type -ap pushsource-ls | sed -n 2p)

for arg in "$@"; do
    if [[ "$arg" == staged:* ]]; then
        staged_dir="${arg#staged:}"
        find "$staged_dir" -type f -o -type d | sort > "$(params.dataDir)/mock_staged_dir.txt"
        break
    fi
done

"$real_pushsource_ls" "$@" 2>&1 | tee "$(params.dataDir)/mock_pushsource_ls.txt"
exit "${PIPESTATUS[0]}"

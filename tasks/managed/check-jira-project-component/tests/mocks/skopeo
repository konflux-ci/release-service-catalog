#!/usr/bin/env bash
set -eo pipefail

# Mock skopeo for the check-jira-project-component task tests. The task only ever
# calls `skopeo inspect`, reading security-tracker labels. The smoke test returns
# an image with no `com.redhat.security-tracker-project` label, so the task
# exercises the label read, skips the image (nothing to validate), and exits
# successfully without contacting Jira.
if [[ "$*" == *"inspect"* ]]; then
  echo '{"Architecture": "amd64", "Os": "linux", "Labels": {"com.redhat.component": "api-server"}}'
else
  echo "Unexpected skopeo invocation: $*" >&2
  exit 1
fi

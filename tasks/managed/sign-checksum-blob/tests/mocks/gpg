#!/usr/bin/env bash
# Mock gpg for the Python steps of sign-checksum-blob.
# --list-packets: succeed unless the signature file contains "corrupted".
# --dearmor: write a fixed binary signature to --output for any non-empty stdin.
set -uo pipefail

args="$*"

if [[ "${args}" == *"--list-packets"* ]]; then
  file_path="${*: -1}"
  if [ -f "${file_path}" ] && grep -q "corrupted" "${file_path}" 2>/dev/null; then
    exit 1
  fi
  exit 0
elif [[ "${args}" == *"--dearmor"* ]]; then
  input="$(cat)"
  if [ -n "${input}" ]; then
    output_path=""
    for ((i = 1; i <= $#; i++)); do
      arg="${!i}"
      if [[ "${arg}" == "--output" ]] && ((i < $#)); then
        output_index=$((i + 1))
        output_path="${!output_index}"
        break
      fi
    done
    if [ -n "${output_path}" ]; then
      printf 'dummy-signature' > "${output_path}"
    else
      printf 'dummy-signature'
    fi
  fi
  exit 0
fi

exit 0

#!/usr/bin/env bash
# Mock kubectl calls made by sign-checksum-blob. InternalRequests are mocked
# through the Kubernetes Python client in tests/python_mocks/sitecustomize.py.
set -uo pipefail

args="$*"
echo "Mock kubectl called with: ${args}" >&2

# resolve_keyname(): kubectl get cm/<name> -ojson
if [[ "${args}" == *"get cm/test-signing-config-map"* ]]; then
  echo '{"data": {"SIG_KEY_NAME": "redhate2etesting", "KERBEROS_KEYTAB_SECRET": "kerberos-keytab-secret", "KERBEROS_KEYTAB": "keytab", "KERBEROS_PRINCIPAL": "signing@EXAMPLE.COM"}}'
  exit 0
fi
if [[ "${args}" == *"get cm/"* ]] || [[ "${args}" == *"get configmap"* ]]; then
  echo "Unexpected ConfigMap lookup: ${args}" >&2
  exit 1
fi

echo "Unexpected kubectl call: ${args}" >&2
exit 1

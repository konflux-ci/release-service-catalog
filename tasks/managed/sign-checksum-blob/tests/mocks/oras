#!/usr/bin/env bash
# Mock oras for the Python steps of sign-checksum-blob. On `pull`, recreate the
# generic-signing output Trusted Artifact contents (results.json + a detached
# signature) in the current working directory (the download dir).
set -uo pipefail

args="$*"
echo "Mock oras called with: ${args}" >&2

if [[ "${args}" == *"pull"* ]]; then
  mkdir -p signatures
  printf -- '-----BEGIN PGP SIGNATURE-----\nmock-armored-signature\n-----END PGP SIGNATURE-----\n' \
    > signatures/0_mock.sig
  cat > results.json <<'EOF'
{"results": [{"file": "foo_SHA256SUMS", "signature_file": "signatures/0_mock.sig", "key": "testkey"}]}
EOF
fi

exit 0

#!/usr/bin/env bash
# Tekton test mock for skopeo copy (called by helpers/skopeo.py via subprocess).
set -eu

echo "$*" >> "${DATA_DIR}/mock_skopeo.txt"

if [[ "$1" == "copy" ]]; then
  for arg in "$@"; do
    if [[ "${arg}" == dir:* ]]; then
      DEST="${arg#dir:}"
      break
    fi
  done

  if [[ -n "${DEST:-}" ]] && [[ -d "${DATA_DIR}/image_data" ]]; then
    cp "${DATA_DIR}/image_data/"* "${DEST}"/
  fi
  exit 0
fi

echo "mock skopeo: unhandled command: $*" >&2
exit 1

#!/usr/bin/env bash
set -eu

DATA_DIR="${DATA_DIR:-/var/workdir/release}"
mkdir -p "${DATA_DIR}"
echo "kinit $*" >> "${DATA_DIR}/kinit_calls.txt"
call_count=$(grep -c '^' "${DATA_DIR}/kinit_calls.txt")
# Simulate kinit failures on first two calls
if [[ "${call_count}" -lt 3 ]]; then
    echo "cannot contact any KDC" >&2
    exit 1
fi

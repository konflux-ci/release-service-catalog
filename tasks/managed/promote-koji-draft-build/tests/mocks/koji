#!/usr/bin/env bash
set -eu

DATA_DIR="${DATA_DIR:-/var/workdir/release}"
mkdir -p "${DATA_DIR}"
echo "koji $*" >> "${DATA_DIR}/koji_calls.txt"

if [[ "$*" == *listBuilds*source=git+https://gitlab.example.com/rpms/test-foo* ]]; then
    cat <<'EOF'
[{"build_id": 1002, "creation_time": "2025-01-01 01:00:00.000000"},
 {"build_id": 1001, "creation_time": "2025-01-01 00:00:00.000000"}]
EOF
elif [[ "$*" == *listBuilds*source=git+https://gitlab.example.com/rpms/test-bar* ]]; then
    echo '[{"build_id": 2001, "creation_time": "2025-01-01 00:00:00.000000"}]'
fi

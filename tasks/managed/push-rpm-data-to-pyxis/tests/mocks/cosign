#!/usr/bin/env bash
set -euo pipefail

echo "$*" >> "$(params.dataDir)/mock_cosign.txt"

output_file=""
while [[ "$#" -gt 0 ]]; do
  if [[ "$1" == "--output-file" ]]; then
    output_file="$2"
    shift 2
  else
    shift
  fi
done

if [[ -z "${output_file}" ]]; then
  echo "Missing --output-file" >&2
  exit 1
fi

mkdir -p "$(dirname "${output_file}")"
echo '{"spdxVersion": "SPDX-2.3", "packages": []}' > "${output_file}"


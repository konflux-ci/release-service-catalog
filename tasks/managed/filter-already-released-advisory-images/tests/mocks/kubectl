#!/usr/bin/env bash
# Mock kubectl for filter-already-released-advisory-images: InternalRequest is
# created for real (see pre-apply-task-hook.sh), but status.results are never
# filled by a controller in unit tests.
set -euo pipefail

if [[ "$*" == "get internalrequest "*"-o=jsonpath={.status.results}" ]]; then
  UNRELEASED="$(printf '%s' '["new-component"]' | gzip -c | base64 | tr -d '\n')"
  jq -n \
    --arg unreleased "${UNRELEASED}" \
    '{
      result: "Success",
      unreleased_components: $unreleased,
      advisory_url: "https://access.redhat.com/errata/RHBA-2024:1234",
      advisory_internal_url: "https://gitlab.example.com/repo/-/raw/main/data/advisories/dev/2024/1234/advisory.yaml"
    }'
  exit 0
fi

exec /usr/bin/kubectl "$@"

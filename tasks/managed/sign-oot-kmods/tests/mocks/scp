#!/usr/bin/env bash
set -eu

mkdir -p "${PARAM_DATA_DIR}"
echo "$*" >> "${PARAM_DATA_DIR}/mock_scp.txt"

joined="$*"
if [[ "${joined}" != *"UserKnownHostsFile=/tmp/.ssh/known_hosts"* ]]; then
  echo "Error: missing known_hosts option: ${joined}" >&2
  exit 1
fi
if [[ "${joined}" != *"GSSAPIAuthentication=yes"* || "${joined}" != *"GSSAPIDelegateCredentials=yes"* ]]; then
  echo "Error: missing GSSAPI options: ${joined}" >&2
  exit 1
fi

args=("$@")
last="${args[-1]}"
if [[ "${last}" == *@*:* ]]; then
  exit 0
fi

remote=""
for arg in "$@"; do
  if [[ "${arg}" == *@*:* ]]; then
    remote="${arg}"
  fi
done
if [[ -z "${remote}" ]]; then
  echo "Error: unable to determine scp operation: ${joined}" >&2
  exit 1
fi

workdir="$(mktemp -d)"
echo "SIGNED_MODULE1" > "${workdir}/mod1.ko"
echo "SIGNED_MODULE2" > "${workdir}/mod2.ko"
tar -czf "${last}" -C "${workdir}" .
rm -rf "${workdir}"

#!/usr/bin/env bash
set -euo pipefail

IMAGE="${@: -1}"

case "${IMAGE}" in
  *comp-released@sha256:released111*)
    echo "sha256:released111"
    ;;
  *target-released:v1.0*)
    echo "sha256:released111"
    ;;
  *comp-kept@sha256:kept222*)
    echo "sha256:kept222"
    ;;
  *target-kept:v1.0*)
    exit 1
    ;;
  *)
    exit 1
    ;;
esac

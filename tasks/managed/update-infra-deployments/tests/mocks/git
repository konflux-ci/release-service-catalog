#!/usr/bin/env bash
# Mock git for update-infra-deployments Tekton tests.
set -euo pipefail

echo "Mock git called with: $*" >&2

case "${1:-}" in
  clone)
    dest="${!#}"
    if [[ "${dest}" != /* ]]; then
      dest="$(pwd)/${dest}"
    fi
    mkdir -p "${dest}/config"
    printf '%s\n' '    newTag: old-revision-sha' > "${dest}/config/deployment.yaml"
    ;;
  fetch|reset|remote|add|commit|push|config)
    ;;
  checkout)
    ;;
  diff)
    cat <<'EOF'
diff --git a/config/deployment.yaml b/config/deployment.yaml
--- a/config/deployment.yaml
+++ b/config/deployment.yaml
-    newTag: old-revision-sha
+    newTag: abc123def456
EOF
    ;;
  status)
    printf '%s\n' ' M config/deployment.yaml'
    ;;
  show-ref)
    exit 1
    ;;
  *)
    echo "Mock git: unexpected command: $*" >&2
    exit 1
    ;;
esac

#!/usr/bin/env bash
# Mock kubectl for create-advisory: InternalRequest is created for real, but
# status.results are never filled by a controller in unit tests.
set -euo pipefail

if [[ "$*" == "get internalrequest "*"-o=jsonpath={.status.results}" ]]; then
  echo '{"result":"Success","advisory_url":"https://access.redhat.com/errata/RHBA-2025:1111"}'
  exit 0
fi

exec /usr/bin/kubectl "$@"

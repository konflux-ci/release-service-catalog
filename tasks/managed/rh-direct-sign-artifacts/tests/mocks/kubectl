#!/usr/bin/env bash
set -eo pipefail

_self_dir="$(cd "$(dirname "$0")" && pwd)"
_real=""
IFS=: read -ra _dirs <<< "${PATH}"
for _d in "${_dirs[@]}"; do
    if [ "${_d}" != "${_self_dir}" ] && [ -x "${_d}/kubectl" ]; then
        _real="${_d}/kubectl"
        break
    fi
done

exec "${_real}" "$@"

#!/usr/bin/env bash
# Mock oras: handle pull commands by creating expected artifacts.
if [[ "$*" == *"pull"* ]]; then
  output_dir=""
  oci_ref=""
  skip_next=""
  for arg in "$@"; do
    if [[ -n "${skip_next}" ]]; then
      if [[ "${skip_next}" == "output" ]]; then
        output_dir="${arg}"
      fi
      skip_next=""
      continue
    fi
    case "${arg}" in
      -o|--output) skip_next="output" ;;
      --registry-config) skip_next="config" ;;
      pull) ;;
      *) oci_ref="${arg}" ;;
    esac
  done
  if [[ -z "${output_dir}" ]]; then
    output_dir="."
  fi
  mkdir -p "${output_dir}"
  if [[ "${oci_ref}" == *"filter-results"* ]]; then
    tmpdir="$(mktemp -d)"
    cat /tmp/mock_unreleased_rpms.json > "${tmpdir}/unreleased_rpms.json"
    echo '[]' > "${tmpdir}/in_advisory_rpms.json"
    tar -czf "${output_dir}/filter-results.tar.gz" -C "${tmpdir}" \
      unreleased_rpms.json in_advisory_rpms.json
    rm -rf "${tmpdir}"
  else
    touch "${output_dir}/hello-2.12.1-6.fc44.x86_64.rpm"
  fi
fi

#!/usr/bin/env bash
# Mock rpm: parse NVRA from filename for -qp queries, delegate otherwise.
if [[ "${1-}" == "-qp" ]]; then
  file_path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -qp) shift ;;
      --qf) shift 2 ;;
      *) file_path="$1"; shift ;;
    esac
  done
  filename="$(basename "${file_path}")"
  base="${filename%.rpm}"
  arch="${base##*.}"
  nvra="${base%.*}"
  release="${nvra##*-}"
  namever="${nvra%-*}"
  version="${namever##*-}"
  name="${namever%-*}"
  printf '%s|0|%s|%s|%s\n' "${name}" "${version}" "${release}" "${arch}"
else
  /usr/bin/rpm "$@"
fi

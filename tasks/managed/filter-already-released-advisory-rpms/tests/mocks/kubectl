#!/usr/bin/env bash
# Mock kubectl: intercept InternalRequest get queries, delegate everything else.
MOCK_RESULTS='{"result":"Success","filter_results_artifact":"oci:quay.io/mock/filter-results@sha256:mockdigest","advisory_url":"","advisory_internal_url":""}'
if [[ "$*" == *"get internalrequest"*"-o=jsonpath="* ]]; then
  echo "${MOCK_RESULTS}"
elif [[ "$*" == *"apply"* ]] || [[ "$*" == *"delete"* ]] || [[ "$*" == *"create"* ]]; then
  /usr/bin/kubectl "$@"
else
  /usr/bin/kubectl "$@"
fi

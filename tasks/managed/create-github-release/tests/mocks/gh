#!/usr/bin/env bash
# Tekton test mock for gh CLI (called by the Python script via subprocess).
set -eu

# Log all calls for debugging
echo "gh $*" >> "${DATA_DIR:-/tmp}/mock_gh.txt"

# Handle 'gh api repos/<owner>/<repo>/releases' - return empty (no existing release)
if [[ "${1:-}" == "api" ]] && [[ "${2:-}" == *"/releases"* ]]; then
  exit 0
fi

# Handle 'gh release create' - return the release URL
if [[ "${1:-}" == "release" ]] && [[ "${2:-}" == "create" ]]; then
  echo "https://github.com/foo/bar/releases/tag/v1.2.3"
  exit 0
fi

echo "mock gh: unhandled command: $*" >&2
exit 1

#!/usr/bin/env bash
# Tekton test mock for skopeo copy (called by the Python script via subprocess).
set -eu

echo "$*" >> "${PARAM_DATA_DIR}/mock_skopeo.txt"

if [[ "${1}" == "copy" ]]; then
  for arg in "$@"; do
    if [[ "${arg}" == dir:* ]]; then
      DEST="${arg#dir:}"
      break
    fi
  done

  if [[ -n "${DEST:-}" ]] && [[ -d "${PARAM_DATA_DIR}/image_data" ]]; then
    cp "${PARAM_DATA_DIR}/image_data/"* "${DEST}"/
  fi
  exit 0
fi

echo "mock skopeo: unhandled command: $*" >&2
exit 1

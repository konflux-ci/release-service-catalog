#!/usr/bin/env bash
# Tekton test mock for date (called by helpers/date_format.py via subprocess).
# The exact timestamp values don't matter for this test since no repository
# tags reference {{ timestamp }} or {{ release_timestamp }}; the calls just
# need to succeed.
set -euo pipefail

case "$*" in
  "+%Y%m%d %T")
    echo "19800101 00:00:00"
    ;;
  -d*)
    echo "0"
    ;;
  *)
    echo "Error: Unexpected date call: $*" >&2
    exit 1
    ;;
esac

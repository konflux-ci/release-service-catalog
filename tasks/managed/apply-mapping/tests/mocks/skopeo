#!/usr/bin/env bash
# Tekton test mock for skopeo inspect (called by helpers/skopeo.py via subprocess).
set -euo pipefail

echo "Mock skopeo called with: $*" >&2

case "$*" in
  *"--raw"*)
    # Raw manifest inspection: used for annotations and config.mediaType.
    # --raw is appended before --no-tags, so match on its presence rather
    # than a fixed position.
    echo '{"config": {"mediaType": "application/vnd.oci.image.config.v1+json"}, "annotations": {}}'
    ;;
  "inspect "*"docker://"*)
    # Standard inspection: used for labels, env vars, and Created/build-date.
    echo '{"Labels": {"build-date": "2024-07-29T02:17:29"}}'
    ;;
  *)
    echo "Error: Unexpected skopeo call: $*" >&2
    exit 1
    ;;
esac

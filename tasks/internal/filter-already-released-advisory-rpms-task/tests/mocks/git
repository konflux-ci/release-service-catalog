#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" == "version" ]]; then
  echo "git version 2.43.0"
  exit 0
fi

if [[ "$1" == "clone" ]]; then
  mkdir -p "${@: -1}"
  exit 0
fi

if [[ "$1" == "sparse-checkout" && "$2" == "set" ]]; then
  echo "$3" > .tekton-mock-sparse-path
  exit 0
fi

if [[ "$1" == "checkout" ]]; then
  if [[ -f .tekton-mock-sparse-path ]]; then
    sparse_path="$(<.tekton-mock-sparse-path)"
    if [[ "${sparse_path}" == *"test-origin"* ]]; then
      dir="${sparse_path}/2025/1601"
      mkdir -p "${dir}"
      cat > "${dir}/advisory.yaml" <<'EOF'
metadata:
  name: "2025:1601"
spec:
  type: RHBA
  content:
    artifacts:
      - purl: pkg:rpm/redhat/released-rpm@1.0-1.fc44?arch=x86_64
EOF
      touch -t 202506141200 "${dir}/advisory.yaml"
    fi
  fi
  exit 0
fi

echo "Error: Unexpected git command: $*" >&2
exit 1

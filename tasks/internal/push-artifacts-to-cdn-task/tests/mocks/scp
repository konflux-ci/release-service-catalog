#!/usr/bin/env bash
# Mock scp: for downloads (remote → local), create an empty destination file.
# Arguments use "-o KEY=VAL" option pairs; skip those to find positional args.
positional=()
skip_next=false
for arg in "$@"; do
  if [[ "${skip_next}" == "true" ]]; then
    skip_next=false
    continue
  fi
  if [[ "${arg}" == "-o" || "${arg}" == "-P" || "${arg}" == "-i" ]]; then
    skip_next=true
    continue
  fi
  if [[ "${arg}" == -* ]]; then
    continue
  fi
  positional+=("${arg}")
done

if [[ ${#positional[@]} -ge 2 ]]; then
  src="${positional[-2]}"
  dest="${positional[-1]}"
  # Download: source is remote (user@host:path), destination is local
  if [[ "${src}" == *@*:* ]] && [[ "${dest}" != *@*:* ]]; then
    touch "${dest}"
  fi
fi
exit 0

#!/usr/bin/env bash
# Mock skopeo: for "copy ... dir:DEST", create a container image directory
# with a single layer tar containing releases/testproduct-linux-amd64.tar.gz.
set -e

DEST=""
for arg in "$@"; do
  if [[ "${arg}" == dir:* ]]; then
    DEST="${arg#dir:}"
    break
  fi
done

if [[ -z "${DEST}" ]]; then
  exit 0
fi

mkdir -p "${DEST}"
TMPDIR=$(mktemp -d)
trap 'rm -rf "${TMPDIR}"' EXIT

# Create the binary content that will live inside the archive
echo "mock binary" > "${TMPDIR}/testproduct-linux-amd64"

# Create the archive file that lives in the container's releases/ directory
mkdir -p "${TMPDIR}/releases"
tar czf "${TMPDIR}/releases/testproduct-linux-amd64.tar.gz" \
  -C "${TMPDIR}" testproduct-linux-amd64

# Package releases/ into a container image layer (uncompressed tar)
LAYER="abc123"
tar cf "${DEST}/${LAYER}" -C "${TMPDIR}" releases/

# Write the image manifest
printf '{"layers":[{"digest":"sha256:%s"}]}\n' "${LAYER}" > "${DEST}/manifest.json"

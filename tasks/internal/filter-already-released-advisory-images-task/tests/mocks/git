#!/usr/bin/env bash
set -euo pipefail

if [[ "$1" == "version" ]]; then
  echo "git version 2.43.0"
  exit 0
fi

if [[ "$1" == "clone" ]]; then
  mkdir -p "${@: -1}"
  exit 0
fi

if [[ "$1" == "sparse-checkout" && "$2" == "set" ]]; then
  echo "$3" > .tekton-mock-sparse-path
  exit 0
fi

if [[ "$1" == "checkout" ]]; then
  if [[ -f .tekton-mock-sparse-path ]]; then
    sparse_path="$(<.tekton-mock-sparse-path)"
    if [[ "${sparse_path}" == *"test-origin"* ]]; then
      declare -A advisory_mtime=(
        ["2025/1602"]="202506151200"
        ["2025/1601"]="202506141200"
        ["2024/1452"]="202406141200"
        ["2024/1442"]="202406131200"
      )
      for sub in "${!advisory_mtime[@]}"; do
        dir="${sparse_path}/${sub}"
        mkdir -p "${dir}"
        printf 'spec: {}\nmetadata: {}\n' > "${dir}/advisory.yaml"
        touch -t "${advisory_mtime[${sub}]}" "${dir}/advisory.yaml"
      done
    fi
  fi
  exit 0
fi

echo "Error: Unexpected git command: $*" >&2
exit 1

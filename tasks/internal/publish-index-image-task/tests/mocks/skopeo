#!/usr/bin/env bash

set -euo pipefail

command="${1}"

case "${command}" in
  inspect)
    image_ref="${*: -1}"
    image_ref="${image_ref#docker://}"

    if [[ "${image_ref}" == "quay.io/source@sha256:abcdef1234567890" ]]; then
      if [[ " $* " == *" --config "* ]]; then
        cat <<'EOF'
{
  "config": {
    "Labels": {
      "com.redhat.index.delivery.version": "v4.12"
    }
  }
}
EOF
      else
        cat <<'EOF'
{
  "Digest": "sha256:abcdef1234567890",
  "Labels": {
    "com.redhat.index.delivery.version": "v4.12"
  }
}
EOF
      fi
    elif [[ "${image_ref}" == "quay.io/target" ]]; then
      if [[ " $* " == *" --config "* ]]; then
        echo '{"config":{"Labels":{}}}'
      else
        echo '{"Digest":"sha256:target-not-published-yet","Labels":{}}'
      fi
    else
      echo "Unexpected image reference: ${image_ref}" >&2
      exit 1
    fi
    ;;
  copy)
    ;;
  *)
    echo "Unknown skopeo command: ${command}" >&2
    exit 1
    ;;
esac

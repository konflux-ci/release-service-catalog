#!/usr/bin/env bash
echo Mock pulp_push_wrapper called with: "$@"

if [[ ! "$*" =~ --pulp-task-timeout-seconds[[:space:]]+[1-9][0-9]* ]]; then
  echo "Error: pulp_push_wrapper called without a valid positive --pulp-task-timeout-seconds value" >&2
  exit 1
fi

if [[ "$*" != *"--pulp-url https://pulp.com"* ]]; then
  echo "Mocked failure of pulp_push_wrapper" >&2
  exit 1
fi

#!/usr/bin/env bash

set -eu

# The Windows signing helper expects the remote script to print the digest
# produced by its signed-artifact push. Cleanup SSH calls do not need output.
if [[ "${*: -1}" != Remove-Item* ]]; then
  echo "Digest: sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
fi

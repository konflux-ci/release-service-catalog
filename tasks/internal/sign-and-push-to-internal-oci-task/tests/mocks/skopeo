#!/usr/bin/env bash

set -eu

# Create the minimal directory-transport layout expected by the extractor.
destination="${@: -1}"
destination="${destination#dir:}"
mkdir -p "${destination}"

archive_name="test-artifact.tar.gz"
windows_archive_name="test-windows-artifact.tar.gz"
work_dir="$(mktemp -d)"
trap 'rm -rf "${work_dir}"' EXIT
printf 'test artifact\n' > "${work_dir}/artifact.txt"
tar -czf "${work_dir}/${archive_name}" -C "${work_dir}" artifact.txt
printf 'test Windows artifact\n' > "${work_dir}/${windows_archive_name}"

digest="$(sha256sum "${work_dir}/${archive_name}" | cut -d ' ' -f 1)"
windows_digest="$(sha256sum "${work_dir}/${windows_archive_name}" | cut -d ' ' -f 1)"
cp "${work_dir}/${archive_name}" "${destination}/${digest}"
cp "${work_dir}/${windows_archive_name}" "${destination}/${windows_digest}"
cat > "${destination}/manifest.json" <<EOF
{
  "schemaVersion": 2,
  "layers": [
    {
      "mediaType": "application/gzip",
      "digest": "sha256:${digest}",
      "size": $(stat -c '%s' "${work_dir}/${archive_name}"),
      "annotations": {
        "org.opencontainers.image.title": "${archive_name}"
      }
    },
    {
      "mediaType": "application/zip",
      "digest": "sha256:${windows_digest}",
      "size": $(stat -c '%s' "${work_dir}/${windows_archive_name}"),
      "annotations": {
        "org.opencontainers.image.title": "${windows_archive_name}"
      }
    }
  ]
}
EOF
